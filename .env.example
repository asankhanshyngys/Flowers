# Copy to .env.local for development. Never commit .env.local.
TURSO_DATABASE_URL=file:./flowers.db
TURSO_AUTH_TOKEN=
ADMIN_EMAILS=
SITE_ORIGIN=http://localhost:3000
ADMIN_SETUP_TOKEN_HASH=
# Optional: automatic recovery emails need a verified sender and secret key.
RESEND_API_KEY=
ADMIN_EMAIL_FROM=
# Preview only, with its own separate database:
ALLOW_PREVIEW_DATABASE=false

# Vercel Blob public store, connected to production
BLOB_READ_WRITE_TOKEN=
