# Server-only comma-separated allowlist. Fail closed when empty.
ADMIN_EMAILS=
# Exact public site origin; used for mutation CSRF checks.
SITE_ORIGIN=https://petal-and-stem-catalog.oobu641.chatgpt.site

# SHA-256 of a private one-time activation token; server secret only.
ADMIN_SETUP_TOKEN_HASH=

# Server-only Resend credential and a verified sender; never expose in client code.
RESEND_API_KEY=
ADMIN_EMAIL_FROM=
