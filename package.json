{
  "name": "flowers",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test:backend": "node --experimental-transform-types --test tests/backend.test.mjs",
    "lint:catalog": "oxlint app server db lib components/admin-login.tsx components/homepage.tsx components/price-filter.tsx components/store-chrome.tsx components/catalog.tsx components/product-image.tsx components/selection-sheet.tsx components/admin-catalog.tsx hooks/use-catalog.ts hooks/use-resource.ts hooks/use-catalog-tool.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed:local": "node --env-file=.env.local scripts/seed-local.mjs",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "vercel-build": "npm run db:migrate && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "next": "16.4.0",
    "@libsql/client": "0.18.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
